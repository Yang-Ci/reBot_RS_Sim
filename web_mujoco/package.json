{
  "name": "rebotarm-web-mujoco",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser MuJoCo demo for B601-RS with an optional AGV base",
  "scripts": {
    "predev": "node scripts/build-campus-scene.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "prebuild": "node scripts/build-campus-scene.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "smoke": "node scripts/smoke-load.mjs",
    "test:loading": "node scripts/test-mesh-transfer.mjs && node scripts/test-model-file-store.mjs && node scripts/test-loading.mjs",
    "test:delivery": "node scripts/test-runtime-delivery.mjs",
    "test:reset": "node scripts/test-reset.mjs",
    "test:dual": "node scripts/test-dual.mjs",
    "test:cooperation": "node scripts/test-cooperation.mjs",
    "test:coffee": "node scripts/test-coffee-feeding.mjs",
    "test:cooperation:robustness": "node scripts/benchmark-cooperation.mjs",
    "test:motion": "node scripts/test-motion-contract.mjs",
    "test:vision": "node scripts/test-vision.mjs --contact",
    "test:vision:extended": "node scripts/test-vision.mjs --contact --extended",
    "test:vision:return": "node scripts/test-vision.mjs --contact --return",
    "test:actions": "node scripts/test-cooperative-actions.mjs",
    "test:visual-ui": "node scripts/test-visual-ui.mjs",
    "test:camera": "node scripts/test-camera-interaction.mjs",
    "test:yolo-grasp": "node scripts/test-yolo-grasp-ui.mjs",
    "test:contact": "node scripts/test-contact-grasp.mjs",
    "test:ci": "npm run test:actions && npm run test:motion && npm run test:timing && npm run test:dual && npm run test:cooperation && npm run test:coffee && npm run test:cooperation:robustness",
    "test:variants": "node scripts/test-agv-path-planner.mjs && node scripts/smoke-variants.mjs",
    "test:campus": "node scripts/build-campus-scene.mjs && node scripts/test-campus.mjs",
    "test:timing": "node scripts/test-simulation-clock.mjs",
    "test:surfaces": "node scripts/test-lab-surfaces.mjs && node scripts/test-campus-ground.mjs",
    "test:explode": "node scripts/test-explosion-layout.mjs && node scripts/test-explosion-timeline.mjs"
  },
  "dependencies": {
    "@mujoco/mujoco": "^3.12.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "vite": "^6.3.5"
  }
}
